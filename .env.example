# Optional — enables live AI suggestions for course descriptions.
# Without a key, the app uses a local template fallback.

# Recommended (free tier via Google AI Studio):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Alternatives:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
