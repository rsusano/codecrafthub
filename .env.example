# Optional — enables live AI suggestions for course descriptions.
# Without a key, the app uses a local template fallback.

# Recommended (free tier via Google AI Studio):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Alternatives:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional — email magic-link login + cloud save for courses & chat
# Create a free project at https://supabase.com then:
# 1) Run supabase/schema.sql in the SQL editor
# 2) Auth → URL Configuration:
#    Site URL: http://localhost:3000 (and https://codecrafthub.vercel.app)
#    Redirect URLs: http://localhost:3000/auth/callback
#                   https://codecrafthub.vercel.app/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
