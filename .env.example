# Live AI (recommended) — set your own Gemini API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Alternatives:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional — Sign in (Google / email) + cloud save for courses & chat
# 1) Create a free project at https://supabase.com
# 2) Run supabase/schema.sql in the SQL editor
# 3) Auth → Providers: enable Email + Google
# 4) Auth → URL Configuration:
#    Site URL: http://localhost:3000 (and https://codecrafthub.vercel.app)
#    Redirect URLs: .../auth/callback for both origins
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
